{
  "name": "@adaptive-harness/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "harness": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "compile": "bun build src/cli.ts --compile --outfile ../../dist/harness"
  },
  "dependencies": {
    "@adaptive-harness/config": "workspace:*",
    "@adaptive-harness/core": "workspace:*",
    "@adaptive-harness/decisions": "workspace:*",
    "@adaptive-harness/persistence": "workspace:*",
    "@adaptive-harness/protocol": "workspace:*",
    "@adaptive-harness/runtime": "workspace:*"
  }
}
